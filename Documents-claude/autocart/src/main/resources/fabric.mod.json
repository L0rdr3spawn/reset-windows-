{
	"schemaVersion": 1,
	"id": "autocart",
	"version": "${version}",
	"name": "Auto Cart",
	"description": "Client-side keybind that places a TNT minecart on a nearby rail, sets a fire on the line to the target and fires a loaded crossbow through it.",
	"authors": [
		"reiss"
	],
	"license": "MIT",
	"icon": "assets/autocart/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"de.reiss.autocart.AutoCartClient"
		]
	},
	"mixins": [
		{
			"config": "autocart.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
