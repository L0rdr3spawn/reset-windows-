{
	"schemaVersion": 1,
	"id": "attrswap",
	"version": "${version}",
	"name": "Attribute Swap",
	"description": "Client-side keybind that attacks, switches hotbar slot and attacks again within a single client tick. Configure in game with /attrswap.",
	"authors": [
		"reiss"
	],
	"license": "MIT",
	"icon": "assets/attrswap/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"de.reiss.attrswap.AttrSwapClient"
		]
	},
	"mixins": [
		{
			"config": "attrswap.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
