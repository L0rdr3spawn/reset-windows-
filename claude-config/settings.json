  },
  "pluginConfigs": {
    "claude-jev@claude-jev": {
      "options": {
        "model": "jev-latest",
        "allowSourceReading": true,
        "maxFileBytes": 65536,
        "maxFilesPerCall": 20,
        "maxRequests": 8
      }
    }
  },
  "autoUpdatesChannel": "latest",
  "theme": "dark",
  "switchModelsOnFlag": false
