    "building-with-jev": {
      "source": {
        "source": "github",
        "repo": "dbreunig/building-with-jev-skill"
      }
    },
    "claude-jev": {
      "source": {
        "source": "directory",
        "path": "C:\\Users\\reiss\\.claude\\local-plugins\\claude-jev"
      }
    },
    "claude-code-addons": {
      "source": {
        "source": "directory",
        "path": "C:\\Users\\reiss\\Claude.Code"
      }
    },
    "agents-observe": {
      "source": {
        "source": "github",
        "repo": "simple10/agents-observe"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "trailofbits": {
      "source": {
        "source": "github",
