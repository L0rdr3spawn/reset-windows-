# Schulmanager – systemd-Unit für die Installation ohne Docker
#
# Installation (Kurzfassung, ausführlich in docs/BETRIEB.md):
#   useradd --system --home /opt/schulmanager --shell /usr/sbin/nologin schulmanager
#   git clone … /opt/schulmanager && cd /opt/schulmanager
#   python3.12 -m venv .venv && .venv/bin/pip install .
#   (cd frontend && npm ci && npm run build)
#   install -d -o schulmanager -g schulmanager -m 0750 /var/lib/schulmanager /var/lib/schulmanager/backups
#   install -D -m 0640 -o root -g schulmanager .env.example /etc/schulmanager/schulmanager.env  # anpassen!
#   cp deploy/systemd/schulmanager.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now schulmanager
#
# Wichtig: genau EIN Prozess/Worker (In-Memory-Planungsdaten + Live-Updates per SSE).

[Unit]
Description=Schulmanager (Stundenplan & Vertretungsplan)
Documentation=file:///opt/schulmanager/docs/BETRIEB.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=exec
User=schulmanager
Group=schulmanager
WorkingDirectory=/opt/schulmanager
EnvironmentFile=/etc/schulmanager/schulmanager.env
Environment=SM_ENV=production
Environment=SM_DATA_DIR=/var/lib/schulmanager
Environment=SM_FRONTEND_DIST=/opt/schulmanager/frontend/dist
Environment=SM_TRUST_PROXY=1
Environment=SM_PROXY_COUNT=1
Environment=SM_TRUSTED_PROXIES=127.0.0.1,::1
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHON=/opt/schulmanager/.venv/bin/python

# Migrationen vor dem Start (idempotent)
ExecStartPre=/opt/schulmanager/scripts/migrate.sh
ExecStart=/opt/schulmanager/.venv/bin/uvicorn schulmanager.server.app:app \
    --host 127.0.0.1 --port 8000 \
    --no-proxy-headers \
    --workers 1 --timeout-graceful-shutdown 15 --timeout-keep-alive 75 \
    --no-server-header --no-access-log
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
TimeoutStartSec=300
TimeoutStopSec=30
KillMode=mixed

# Ressourcen (für ≈2500 Schüler großzügig bemessen)
MemoryHigh=2500M
MemoryMax=3G
TasksMax=512
LimitNOFILE=65536

# Härtung
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/schulmanager
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027

[Install]
WantedBy=multi-user.target
