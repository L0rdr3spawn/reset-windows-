# Schulmanager – Caddy als Reverse Proxy mit automatischem HTTPS (Let's Encrypt)
#
# Umgebungsvariablen (aus .env über docker-compose.yml):
#   SM_DOMAIN    öffentlicher Hostname, z. B. plan.meine-schule.de
#                (mehrere: "plan.schule.de, www.plan.schule.de"; lokal testen: "localhost")
#   ACME_EMAIL   Kontaktadresse für Let's Encrypt (Ablaufwarnungen)
#   ACME_CA      optional, z. B. Let's-Encrypt-Staging für Tests:
#                https://acme-staging-v02.api.letsencrypt.org/directory
#   SM_UPSTREAM  optional, Default app:8000
#
# Voraussetzungen für Let's Encrypt: DNS-A/AAAA-Eintrag zeigt auf den Server, Ports 80 und 443
# (TCP, für HTTP/3 zusätzlich 443/UDP) sind aus dem Internet erreichbar.
#
# Rate-Limiting: Caddy enthält ohne Plugin kein Rate-Limit. Der Login ist in der App selbst
# gegen Brute-Force geschützt (Sperre nach SM_LOGIN_MAX_FAILURES Fehlversuchen pro Konto,
# SM_LOGIN_MAX_FAILURES_IP pro IP). Zusätzliches Proxy-Rate-Limit: siehe deploy/caddy/README.md.
{
	email {$ACME_EMAIL}
	acme_ca {$ACME_CA:https://acme-v02.api.letsencrypt.org/directory}

	# Offene SSE-Verbindungen bei "caddy reload" höchstens so lange halten
	grace_period 10s

	servers {
		# Steht ein weiterer Proxy/Load-Balancer (z. B. Hoster-LB) vor Caddy, dessen Netz hier
		# eintragen, damit die echte Client-IP weitergereicht wird:
		# trusted_proxies static 10.0.0.0/8
		protocols h1 h2 h3
	}
}

# ---------------------------------------------------------------------------
# Wiederverwendbare Bausteine
# ---------------------------------------------------------------------------
(security_headers) {
	header {
		# HSTS: Browser verwenden zwei Jahre lang nur noch HTTPS
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		# Die folgenden Header nur setzen, wenn die App sie nicht selbst liefert ("?")
		?X-Content-Type-Options "nosniff"
		?X-Frame-Options "DENY"
		?Referrer-Policy "strict-origin-when-cross-origin"
		?Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		?Cross-Origin-Opener-Policy "same-origin"
		?Cross-Origin-Resource-Policy "same-origin"
		?X-Permitted-Cross-Domain-Policies "none"
		-Server
		-X-Powered-By
	}
	# CSP-Fallback (die App setzt ihre eigene CSP, inkl. Ausnahme für die API-Doku /api/docs).
	# Greift z. B. für Caddys eigene Fehlerseiten.
	@spa not path /api/docs /api/docs/*
	header @spa ?Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
}

(access_log) {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				# Persönliche iCal-Tokens nicht ins Log schreiben
				request>uri regexp "^/ical/[^/?]+" "/ical/***"
				# Datensparsamkeit (DSGVO): letztes IPv4-Oktett / IPv6 ab /48 kürzen
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>client_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>headers>X-Forwarded-For delete
			}
		}
	}
}

(upstream) {
	reverse_proxy {$SM_UPSTREAM:app:8000} {
		# Kurzer Keep-Alive als uvicorn (75 s) → keine Race-Conditions bei Idle-Verbindungen
		transport http {
			keepalive 60s
			dial_timeout 5s
		}
		# Während eines Neustarts der App Anfragen kurz zurückhalten statt sofort 502
		lb_try_duration 15s
		lb_try_interval 500ms
		# X-Forwarded-For/-Proto/-Host setzt Caddy automatisch (eingehende Werte von
		# nicht vertrauenswürdigen Clients werden verworfen → nicht fälschbar).
	}
}

# ---------------------------------------------------------------------------
# HTTPS-Site
# ---------------------------------------------------------------------------
{$SM_DOMAIN} {
	import security_headers
	import access_log

	# Uploads (Untis-/CSV-/JSON-Import) begrenzen
	request_body {
		max_size 50MB
	}

	# Prometheus-Metriken nur intern (Prometheus scrapt app:8000/metrics direkt)
	handle /metrics* {
		respond 404
	}

	# Server-Sent Events: ohne Kompression und ohne Pufferung durchreichen
	handle /api/v1/events* {
		reverse_proxy {$SM_UPSTREAM:app:8000} {
			flush_interval -1
			transport http {
				keepalive 60s
				dial_timeout 5s
			}
		}
	}

	# Standortspezifische Ergänzungen (z. B. Rate-Limit mit Plugin, IP-Sperren): *.caddy-Dateien
	# in deploy/caddy/conf.d/ werden hier eingebunden (siehe deploy/caddy/README.md).
	import /etc/caddy/conf.d/*.caddy

	handle {
		encode zstd gzip
		import upstream
	}

	# Freundliche Fehlerseite, wenn die App (noch) nicht erreichbar ist
	handle_errors 502 503 504 {
		header Content-Type "text/html; charset=utf-8"
		header Retry-After "30"
		respond `<!doctype html><html lang="de"><meta charset="utf-8"><meta http-equiv="refresh" content="30"><title>Schulmanager – Wartung</title><body style="font-family:system-ui,sans-serif;max-width:40rem;margin:4rem auto;padding:0 1rem"><h1>Schulmanager startet gerade neu</h1><p>Der Dienst ist in Kürze wieder erreichbar. Diese Seite lädt sich automatisch neu.</p></body></html>` 503
	}
}
