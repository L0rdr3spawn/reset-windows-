# Schulpuls – Lastausgleich vor mehreren App-Knoten (BEISPIEL, nicht automatisch geladen)
#
# Voraussetzungen (siehe docs/UPDATES-UND-HOCHVERFUEGBARKEIT.md, Abschnitt "Mehrere Server"):
#   * gemeinsame PostgreSQL-Datenbank (SQLite geht nicht), von allen Knoten erreichbar
#   * gemeinsame Dateiablage (SM_FILES_DIR, z. B. NFS/Ceph) und gleiche SM_SECRET_KEY / SM_ENCRYPTION_KEYS auf allen Knoten
#   * je Knoten eigene SM_NODE_ID (app1, app2, …) und SM_HA=1
#   * dieser Proxy ist selbst ein einzelner Punkt – für echte Ausfallsicherheit zwei Proxys mit gemeinsamer Adresse
#     (keepalived/VRRP oder Hoster-Lastverteiler) betreiben
#
# Der Update-Agent legt beim Aktualisieren eines Knotens die Datei drain-<SM_NODE_ID>.flag im Datenordner an; die App
# antwortet dann auf /healthz/ready mit 503, und dieser Proxy schickt keine neuen Anfragen mehr dorthin.
{
	email {$ACME_EMAIL}
}

{$SM_DOMAIN} {
	# Live-Updates (SSE) ohne Pufferung; angemeldete Nutzer bleiben über das Cookie auf "ihrem" Knoten
	@sse path /api/v1/events*
	handle @sse {
		reverse_proxy app1:8000 app2:8000 {
			lb_policy cookie schulpuls_node
			health_uri /healthz/ready
			health_interval 5s
			health_timeout 2s
			health_status 2xx
			fail_duration 30s
			flush_interval -1
		}
	}

	handle {
		encode zstd gzip
		reverse_proxy app1:8000 app2:8000 {
			# Sitzungen liegen in der Datenbank, der Plan wird alle 2 s nachgeladen. Das Cookie hält einen Nutzer trotzdem
			# beim selben Knoten: Job-Fortschritt (Stundenplan-Berechnung) und Live-Updates kommen vom eigenen Knoten.
			lb_policy cookie schulpuls_node
			health_uri /healthz/ready
			health_interval 5s
			health_timeout 2s
			health_status 2xx
			fail_duration 30s
			# Beim Neustart eines Knotens Anfragen kurz zurückhalten statt sofort 502
			lb_try_duration 10s
			lb_try_interval 500ms
		}
	}
}
