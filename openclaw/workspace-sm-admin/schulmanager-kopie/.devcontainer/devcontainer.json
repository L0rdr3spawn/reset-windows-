// Vorschau in GitHub Codespaces: Code → Codespaces → „Create codespace“ (bzw. Link in README.md).
// Beim ersten Start werden Abhängigkeiten installiert und die Oberfläche gebaut (einige Minuten), danach startet die
// App mit der Demo-Schule auf Port 8000 und öffnet sich im Browser. Testanleitung: docs/VORSCHAU.md
{
  "name": "Schulmanager – Vorschau",
  "image": "mcr.microsoft.com/devcontainers/python:3-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "postCreateCommand": "pip install --no-cache-dir -e '.[dev]' && npm --prefix frontend ci && npm --prefix frontend run build",
  "postStartCommand": "scripts/preview.sh --background",
  // Protokoll im Terminal mitlaufen lassen: Seitenaufrufe erzeugen Terminal-Ausgabe und zählen damit als Aktivität
  // (sonst stoppt der Codespace trotz Nutzung der App nach der Leerlaufzeit)
  "postAttachCommand": "tail -n 0 -F data/preview/server.log",
  "containerEnv": { "TZ": "Europe/Berlin" },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Schulmanager", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["docs/VORSCHAU.md"] },
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    }
  }
}
